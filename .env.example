# Copy to .env for local (non-Docker) development.
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://ris:ris@localhost:5432/ris
# Usual residents per private dwelling (ABS 2021, Melbourne City SA3: 149,601 / 103,029)
PERSONS_PER_DWELLING=1.45
# Windows + OSGeo4W only, e.g.
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll
